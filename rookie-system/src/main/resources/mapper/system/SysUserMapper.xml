<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.rookie.system.mapper.SysUserMapper">

    <resultMap id="sysUserVo" type="com.rookie.system.pojo.vo.SysUserVo">
        <id property="userId" column="user_id"/>
        <result property="username" column="username"/>
        <result property="nickName" column="nick_name"/>
        <result property="phoneNumber" column="phone_number"/>
        <result property="sex" column="sex"/>
        <result property="status" column="status"/>
        <result property="createTime" column="create_time"/>
        <collection property="userRole" javaType="java.util.List" resultMap="userRole"/>
        <collection property="roleId" javaType="java.util.List" resultMap="roleId"/>
    </resultMap>

    <resultMap id="userRole" type="com.rookie.common.pojo.entity.SysRole">
        <result property="roleId" column="role_id"/>
        <result property="roleName" column="role_name"/>
        <result property="status" column="status"/>
        <result property="isDefault" column="is_default"/>
    </resultMap>

    <resultMap id="roleId" type="long">
        <result column="role_id"/>
    </resultMap>

    <resultMap id="sysUserEntity" type="com.rookie.common.pojo.entity.SysUser">
        <id property="userId" column="user_id"/>
        <result property="username" column="username"/>
        <result property="password" column="password"/>
        <result property="nickName" column="nick_name"/>
        <result property="sex" column="sex"/>
        <result property="phoneNumber" column="phone_number"/>
        <result property="avatar" column="avatar"/>
        <result property="status" column="status"/>
        <result property="delete" column="delete"/>
        <result property="createTime" column="create_time"/>
        <result property="createBy" column="create_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="updateBy" column="update_by"/>
    </resultMap>

    <select id="quarryUser" parameterType="com.rookie.system.pojo.quarry.UserQuarry" resultMap="sysUserEntity">
        select * from sys_user
        where `delete`=0
        <if test="username != null and username != ''">
            and username like concat("%",#{username},"%")
        </if>
        <if test="nickName!=null and nickName != ''">
            and nick_name like concat("%",#{nickName},"%")
        </if>
        <if test="phoneNumber!=null and phoneNumber!=''">
            and phone_number like concat('%',#{phoneNumber},'%')
        </if>
        <if test="status!=null">
            and status =#{status}
        </if>
        <if test="beginTime != null and beginTime != ''"><!-- 开始时间检索 -->
            AND date_format(create_time,'%Y%m%d') &gt;= date_format(#{beginTime},'%Y%m%d')
        </if>
        <if test="endTime != null and endTime != ''"><!-- 结束时间检索 -->
            AND date_format(create_time,'%Y%m%d') &lt;= date_format(#{endTime},'%Y%m%d')
        </if>
    </select>

    <select id="selectSysUserById" parameterType="long" resultMap="sysUserVo">
        select u.user_id, u.username ,u.nick_name ,u.phone_number ,u.sex ,u.status ,u.create_time,
            r.role_id , r.role_name, r.role_level, r.status, r.is_default, r.create_by, r.create_time, r.update_by, r.update_time
        from sys_user u
        left join sys_user_role ur on u.user_id = ur.user_id
        left join sys_role r on ur.role_id = r.role_id
        where u.user_id = #{userId}
    </select>


    <update id="editUserInfo" parameterType="com.rookie.common.pojo.entity.SysUser">
        update sys_user
        set
        <if test="username!='' and username!=null"> username=#{username},</if>
        <if test="nickName!='' and nickName!=null">nick_name=#{nickName},</if>
        <if test="phoneNumber!='' and phoneNumber!=null">phone_number=#{phoneNumber},</if>
        <if test="sex!='' and sex!=null">sex=#{sex},</if>
        <if test="status!=null">`status`=#{status},</if>
        update_by = #{updateBy},
        update_time=now()
        where user_id = #{userId}
    </update>

    <insert id="addSysUser" parameterType="com.rookie.common.pojo.entity.SysUser" useGeneratedKeys="true" keyProperty="userId">
        insert into sys_user
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="username!=null">username,</if>
            <if test="password!=null">password,</if>
            <if test="nickName!=null">nick_name,</if>
            <if test="sex!=null">sex,</if>
            <if test="phoneNumber!=null">phone_number,</if>
            <if test="avatar!=null">avatar,</if>
            create_by, create_time, update_by, update_time
        </trim>
        values
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="username!=null">#{username},</if>
            <if test="password!=null">#{password},</if>
            <if test="nickName!=null">#{nickName},</if>
            <if test="sex!=null">#{sex},</if>
            <if test="phoneNumber!=null">#{phoneNumber},</if>
            <if test="avatar!=null">#{avatar},</if>
            #{createBy}, now(), #{updateBy}, now()
        </trim>
    </insert>

    <select id="usernameIsExistOrNot" parameterType="string" resultType="boolean">
        select * from sys_user where username = #{username}
    </select>

    <select id="phoneIsExistOrNot" parameterType="string" resultType="boolean">
        select * from sys_user where phone_number = #{phoneNumber}
    </select>

    <delete id="deleteSysUserById" parameterType="long">
        delete from sys_user where user_id=#{userId}
    </delete>

    <update id="changeSysUserStatus">
        update sys_user set status = #{status} where user_id =#{userId}
    </update>

    <select id="getSysUserInfoById" parameterType="long" resultMap="sysUserEntity">
        select * from sys_user where user_id=#{userId}
    </select>

    <update id="resetSysUserPassword" parameterType="com.rookie.common.pojo.entity.SysUser">
        update sys_user
        set password = #{password}
        where user_id = #{userId}
    </update>

    <update id="updateSysUserAvatar" parameterType="com.rookie.common.pojo.entity.SysUser">
        update sys_user
        set avatar = #{avatar},
            update_by = #{updateBy},
            update_time = now()
        where user_id = #{userId}
    </update>

</mapper>
