<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.rookie.system.mapper.SysMenuMapper">

    <resultMap id="sysMenuVo" type="com.rookie.system.pojo.vo.SysMenuVo">
        <id property="menuId" column="menu_id"/>
        <result property="menuName" column="menu_name"/>
        <result property="permKey" column="perm_key"/>
        <result property="parentId" column="parent_id"/>
        <result property="menuType" column="menu_type"/>
        <result property="route" column="route"/>
        <result property="backlinks" column="backlinks"/>
        <result property="path" column="path"/>
        <result property="icon" column="icon"/>
        <result property="sort" column="sort"/>
        <result property="status" column="status"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <resultMap id="sysMenuEntity" type="com.rookie.common.pojo.entity.SysMenu">
        <id property="menuId" column="menu_id"/>
        <result property="menuName" column="menu_name"/>
        <result property="permKey" column="perm_key"/>
        <result property="parentId" column="parent_id"/>
        <result property="menuType" column="menu_type"/>
        <result property="route" column="route"/>
        <result property="backlinks" column="backlinks"/>
        <result property="path" column="path"/>
        <result property="icon" column="icon"/>
        <result property="sort" column="sort"/>
        <result property="status" column="status"/>
        <result property="delete" column="delete"/>
        <result property="createTime" column="create_time"/>
        <result property="createBy" column="create_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="updateBy" column="update_by"/>
    </resultMap>

    <select id="quarrySysMenu" parameterType="com.rookie.system.pojo.quarry.MenuQuarry" resultMap="sysMenuVo">
        select * from sys_menu
        where `delete` = 0
            <if test="menuName!=null and menuName!=''">and menu_name like concat('%',#{menuName},'%')</if>
            <if test="permKey!=null and permKey!=''">and perm_key like concat('%',#{permKey},'%')</if>
            <if test="status!=null">
                and status =#{status}
            </if>
            <if test="beginTime != null and beginTime != ''"><!-- 开始时间检索 -->
                AND date_format(create_time,'%Y%m%d') &gt;= date_format(#{beginTime},'%Y%m%d')
            </if>
            <if test="endTime != null and endTime != ''"><!-- 结束时间检索 -->
                AND date_format(create_time,'%Y%m%d') &lt;= date_format(#{endTime},'%Y%m%d')
            </if>
        order by parent_id, sort, menu_id

    </select>


    <insert id="addSysMenu" parameterType="com.rookie.common.pojo.entity.SysMenu">
        insert into sys_menu
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="menuName!=null">menu_name,</if>
            <if test="permKey!=null">perm_key,</if>
            <if test="parentId!=null">parent_id,</if>
            <if test="menuType!=null">menu_type,</if>
            <if test="route!=null">route,</if>
            <if test="backlinks!=null">backlinks,</if>
            <if test="path!=null">path,</if>
            <if test="icon!=null">icon,</if>
            <if test="sort!=null">sort,</if>
            create_by, create_time, update_by, update_time
        </trim>
        values
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="menuName!=null">#{menuName},</if>
            <if test="permKey!=null">#{permKey},</if>
            <if test="parentId!=null">#{parentId},</if>
            <if test="menuType!=null">#{menuType},</if>
            <if test="route!=null">#{route},</if>
            <if test="backlinks!=null">#{backlinks},</if>
            <if test="path!=null">#{path},</if>
            <if test="icon!=null">#{icon},</if>
            <if test="sort!=null">#{sort},</if>
            #{createBy}, now(), #{updateBy}, now()
        </trim>
    </insert>

    <update id="editSysMenuInfo" parameterType="com.rookie.common.pojo.entity.SysMenu">
        update sys_menu
        set
        <if test="menuName!=null and menuName!=''"> menu_name = #{menuName},</if>
        <if test="permKey!=null and permKey!=''">perm_key = #{permKey},</if>
        <if test="parentId!=null">parent_id=#{parentId},</if>
        <if test="menuType!=null">menu_type = #{menuType},</if>
        <if test="route!=null and route!=''">route=#{route},</if>
        <if test="backlinks!=null"> backlinks = #{backlinks},</if>
        <if test="path!=null and path!=''">path= #{path},</if>
        <if test="icon!=null and icon!=''">icon=#{icon},</if>
        <if test="sort!=null">sort=#{sort},</if>
        <if test="status!=null and status!=''">status=#{status},</if>
        update_by = #{updateBy}, update_time = now()
        where menu_id =#{menuId}
    </update>

    <select id="getSysMenuInfo" parameterType="integer" resultMap="sysMenuEntity">
        select * from sys_menu where menu_id=#{menuId}
    </select>

    <delete id="deleteSysMenuInfo" parameterType="integer">
        delete from sys_menu where menu_id = #{menuId}
    </delete>

    <update id="changeSysMenuStatus" parameterType="integer">
        update sys_menu set status = #{status} where menu_id = #{menuId}
    </update>

    <select id="getSysMenuByMenuIds" resultMap="sysMenuVo">
        select * from sys_menu
        where `delete` = 0
          and status = 1
          and menu_id in
        <foreach collection="list" item="menuId" open="(" close=")" separator=",">
            #{menuId}
        </foreach>
        order by parent_id, sort, menu_id
    </select>

    <!-- 查询全部启用且未删除的菜单（含目录/菜单/按钮），供超级管理员菜单树兜底。
         不限 menuId，复用 sysMenuVo resultMap，与 getSysMenuByMenuIds 返回结构一致。 -->
    <select id="getSysMenuAllEnabled" resultMap="sysMenuVo">
        select * from sys_menu
        where `delete` = 0
          and status = 1
        order by parent_id, sort, menu_id
    </select>

</mapper>
