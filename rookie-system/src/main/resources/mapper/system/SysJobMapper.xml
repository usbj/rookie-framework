<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.rookie.system.mapper.SysJobMapper">

    <resultMap id="sysJobEntity" type="com.rookie.common.pojo.entity.SysJob">
        <id property="jobId" column="job_id"/>
        <result property="jobName" column="job_name"/>
        <result property="beanName" column="bean_name"/>
        <result property="methodName" column="method_name"/>
        <result property="cronExpression" column="cron_expression"/>
        <result property="params" column="params"/>
        <result property="status" column="status"/>
        <result property="remark" column="remark"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <select id="quarrySysJob" parameterType="com.rookie.system.pojo.quarry.SysJobQuarry" resultMap="sysJobEntity">
        select * from sys_job
        <where>
            <if test="jobName != null and jobName != ''">
                and job_name like concat('%', #{jobName}, '%')
            </if>
            <if test="status != null">
                and status = #{status}
            </if>
            <if test="beginTime != null and beginTime != ''">
                and date_format(create_time,'%Y%m%d') &gt;= date_format(#{beginTime},'%Y%m%d')
            </if>
            <if test="endTime != null and endTime != ''">
                and date_format(create_time,'%Y%m%d') &lt;= date_format(#{endTime},'%Y%m%d')
            </if>
        </where>
        order by create_time desc
    </select>

    <select id="getSysJobById" parameterType="long" resultMap="sysJobEntity">
        select * from sys_job where job_id = #{jobId}
    </select>

    <select id="getAllEnabledJobs" resultMap="sysJobEntity">
        select * from sys_job where status = 1 order by job_id asc
    </select>

    <insert id="addSysJob" parameterType="com.rookie.common.pojo.entity.SysJob" useGeneratedKeys="true" keyProperty="jobId">
        insert into sys_job
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="jobName!=null">job_name,</if>
            <if test="beanName!=null">bean_name,</if>
            <if test="methodName!=null">method_name,</if>
            <if test="cronExpression!=null">cron_expression,</if>
            <if test="params!=null">params,</if>
            <if test="status!=null">status,</if>
            <if test="remark!=null">remark,</if>
            create_by, create_time, update_by, update_time
        </trim>
        values
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="jobName!=null">#{jobName},</if>
            <if test="beanName!=null">#{beanName},</if>
            <if test="methodName!=null">#{methodName},</if>
            <if test="cronExpression!=null">#{cronExpression},</if>
            <if test="params!=null">#{params},</if>
            <if test="status!=null">#{status},</if>
            <if test="remark!=null">#{remark},</if>
            #{createBy}, now(), #{updateBy}, now()
        </trim>
    </insert>

    <update id="editSysJob" parameterType="com.rookie.common.pojo.entity.SysJob">
        update sys_job
        <set>
            <if test="jobName!=null and jobName!=''">job_name=#{jobName},</if>
            <if test="beanName!=null and beanName!=''">bean_name=#{beanName},</if>
            <if test="methodName!=null and methodName!=''">method_name=#{methodName},</if>
            <if test="cronExpression!=null and cronExpression!=''">cron_expression=#{cronExpression},</if>
            <if test="params!=null">params=#{params},</if>
            <if test="status!=null">status=#{status},</if>
            <if test="remark!=null">remark=#{remark},</if>
            update_by=#{updateBy}, update_time=now()
        </set>
        where job_id = #{jobId}
    </update>

    <delete id="deleteSysJobById" parameterType="long">
        delete from sys_job where job_id = #{jobId}
    </delete>

    <update id="changeSysJobStatus">
        update sys_job set status = #{status}, update_time = now() where job_id = #{jobId}
    </update>

</mapper>
